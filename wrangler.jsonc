{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ner-lens",
  "main": "worker.js",
  "compatibility_date": "2026-09-14",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/v1/*", "/health/*"]
  },
  "triggers": {"crons": ["*/10 * * * *"]}
}
